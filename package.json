{
  "name": "webapp",
  "version": "1.0.0",
  "description": "API REST con pipeline CI/CD (Docker + GitHub Actions + AWS EC2)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:instrumented": "node --require ./tracing.js server.js",
    "test": "jest --coverage --runInBand --silent",
    "e2e": "playwright test"
  },
  "keywords": [],
  "author": "Sergio Abdiel Gonzalez Bravo",
  "license": "ISC",
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "app.js",
      "auth.js",
      "db.js",
      "responses.js",
      "server.js",
      "telemetry.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}

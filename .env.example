# Copia este archivo a .env solo en la EC2 y reemplaza todos los valores.
# Nunca subas el archivo .env real al repositorio.
# Los campos obligatorios se dejan vacios para que Docker Compose falle de forma segura.
DOCKERHUB_USERNAME=
IMAGE_TAG=latest
APP_VERSION=unknown

# Credenciales root de OpenObserve para la interfaz y las APIs de administracion.
OO_USER=
OO_PASS=

# Token de ingesta generado por OpenObserve (IAM > Ingestion Tokens).
# OpenObserve v1.1.2+ admite un token o2oi_... en los endpoints OTLP.
OO_INGEST_TOKEN=

# Base64 sin salto de linea de OO_USER:OO_INGEST_TOKEN.
# Genera con: printf %s 'TU_USUARIO:TU_TOKEN_o2oi' | base64 | tr -d '\n'
OO_AUTH_B64=

# Genera con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=
